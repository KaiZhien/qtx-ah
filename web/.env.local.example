# QuantumTX AH — Next.js Frontend Environment Variables
# Copy this file to .env.local and fill in your values.

# ------------------------------------------------------------------
# Must match QTX_API_KEY set on the API server.
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------
NEXT_PUBLIC_API_KEY=

# ------------------------------------------------------------------
# API base URL — change for staging/production deployments
# ------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
