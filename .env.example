# QuantumTX AH — API Server Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# Generate keys with: python3 -c "import secrets; print(secrets.token_hex(32))"

# ------------------------------------------------------------------
# Internal API key — protects all non-webhook endpoints.
# The web dashboard currently mirrors this as NEXT_PUBLIC_API_KEY in
# web/.env.local (being replaced by a server-side BFF proxy — after that
# lands, the key lives only server-side and this note goes away).
# ------------------------------------------------------------------
QTX_API_KEY=<generate: python3 -c "import secrets; print(secrets.token_hex(32))">

# ------------------------------------------------------------------
# Admin key — hot-swap model reload only. MUST differ from QTX_API_KEY.
# Required header: X-Admin-Key
# ------------------------------------------------------------------
QTX_ADMIN_KEY=<must differ from QTX_API_KEY>

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://qtx:secret@localhost:5432/qtxah

# ------------------------------------------------------------------
# Voyage AI embeddings (https://dash.voyageai.com)
# ------------------------------------------------------------------
VOYAGE_API_KEY=<from dash.voyageai.com>

# ------------------------------------------------------------------
# Anthropic Claude (https://console.anthropic.com)
# BAA required before sending real patient data in production.
# ------------------------------------------------------------------
ANTHROPIC_API_KEY=<from console.anthropic.com>

# ------------------------------------------------------------------
# CORS — comma-separated allowed frontend origins.
# Production: set to your deployed frontend URL.
# ------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------
# ML retrain / calibration thresholds
# ------------------------------------------------------------------
LOG_LEVEL=INFO
RETRAIN_THRESHOLD=50
CALIBRATION_DRIFT_THRESHOLD=0.30
CALIBRATION_MIN_COHORT_N=20

# ------------------------------------------------------------------
# Terra wearable integration (https://dashboard.tryterra.co)
# ------------------------------------------------------------------
TERRA_WEBHOOK_SECRET=
TERRA_DEV_ID=
TERRA_API_KEY=
