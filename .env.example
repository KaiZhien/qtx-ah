# QuantumTX AH — API Server Environment Variables
# Copy this file to .env and fill in your values.

# ------------------------------------------------------------------
# Internal API key — protects all non-webhook endpoints.
# Generate with: openssl rand -hex 32
# Must match NEXT_PUBLIC_API_KEY in web/.env.local
# ------------------------------------------------------------------
QTX_API_KEY=

# ------------------------------------------------------------------
# Terra wearable integration (https://dashboard.tryterra.co)
# TERRA_WEBHOOK_SECRET: found in Terra dashboard → Webhooks
# TERRA_DEV_ID:         found in Terra dashboard → API Keys
# TERRA_API_KEY:        found in Terra dashboard → API Keys
# ------------------------------------------------------------------
TERRA_WEBHOOK_SECRET=
TERRA_DEV_ID=
TERRA_API_KEY=

# ------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------
LOG_LEVEL=INFO
